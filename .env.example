# Docket-TTS Configuration
# Copy this file to .env and customize for your environment

# Application Settings
APP_BASE_URL=http://localhost:8000

# LLM OCR Post-Processing
# Endpoint for Ollama API (used to normalize OCR text)
# Adjust port to match your Ollama installation
LLM_API_ENDPOINT=http://localhost:11434/api/generate

# Note: LLM model (qwen3:latest) is configured in app.py
# Set LLM_ENABLED=false in app.py to disable OCR post-processing
